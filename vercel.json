{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/about-us", "destination": "/pamca_about.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/pharmacy-products", "destination": "/pharmacy-products.html" },
    { "source": "/minor-ailments-prescribing-solution", "destination": "/pamca_minor_ailments.html" },
    { "source": "/digital-thermometer", "destination": "/product.html" },
    { "source": "/thermometer-dual-readings", "destination": "/product.html" },
    { "source": "/gel-dispenser", "destination": "/product.html" },
    { "source": "/nfc-counter", "destination": "/product.html" },
    { "source": "/thermometer-dual", "destination": "/thermometer-dual.html" },
    { "source": "/thermometer-mono", "destination": "/thermometer-mono.html" },
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/partials/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] }
  ],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 9 1 * *" }
  ]
}
